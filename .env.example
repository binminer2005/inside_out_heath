SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=
ADMIN_EMAIL=admin@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Or point to Google's downloaded OAuth client JSON (web application credentials).
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# SMTP for password reset emails. Gmail: smtp.gmail.com, port 587; use an App Password.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Add this exact callback URL to the Google OAuth client:
# https://your-domain.example/auth/google/callback
